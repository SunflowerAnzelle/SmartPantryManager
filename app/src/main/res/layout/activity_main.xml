<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pantry_background">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Pantry Manager"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/pantry_primary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage your pantry and discover recipes"
            android:textSize="16sp"
            android:textColor="@color/pantry_secondary"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <Button
        android:id="@+id/btnOpenPantry"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Add Pantry Item"
        android:textSize="16sp" />

        <Button
            android:id="@+id/btnOpenRecipes"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="Suggested Recipes"
            android:layout_gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/white"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Home"
            android:textSize="13sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnNavPantry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Pantry"
            android:textSize="13sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Settings"
            android:textSize="13sp"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>



