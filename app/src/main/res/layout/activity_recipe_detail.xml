<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pantry_background">

    <!-- Scrollable recipe details -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtDetailRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recipe Name"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/pantry_primary"
                android:gravity="center"
                android:paddingBottom="20dp" />

            <TextView
                android:id="@+id/txtDetailIngredientsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingredients"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/pantry_primary"
                android:gravity="center"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/txtDetailIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingredients will appear here."
                android:textSize="17sp"
                android:textColor="@color/pantry_secondary"
                android:paddingBottom="24dp" />

            <TextView
                android:id="@+id/txtDetailStepsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Method"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/pantry_primary"
                android:gravity="center"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/txtDetailSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recipe method will appear here."
                android:textSize="17sp"
                android:textColor="@color/pantry_secondary" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/white"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Home"
            android:textSize="13sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnNavPantry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Pantry"
            android:textSize="13sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Settings"
            android:textSize="13sp"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>

